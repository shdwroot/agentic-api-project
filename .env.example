AGENTIC_API_HOST=127.0.0.1
AGENTIC_API_PORT=8088
AGENTIC_API_LOG_LEVEL=INFO
AGENTIC_API_MAX_CONTEXT_BYTES=1000000
AGENTIC_API_MAX_SCENARIOS=250

# Deterministic planning is the safe default. Optional model augmentation is
# available after installing the `openai` extra and setting all three values.
AGENTIC_API_MODEL_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
